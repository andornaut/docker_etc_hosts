#!/bin/bash

# Usage: ./docker_etc_hosts [OPTIONS]

set -euo pipefail

HOSTS_FILE="/etc/hosts"
DOMAIN="internal"
DRY_RUN=false
WATCH=false
MARKER_BEGIN="# docker_etc_hosts BEGIN"
MARKER_END="# docker_etc_hosts END"

show_help() {
  cat << EOF
Update /etc/hosts with running Docker containers IPs and names

Usage: $0 [OPTIONS]

OPTIONS:
  --domain DOMAIN            Domain for containers (default: internal)
  --dry-run                  Write the resulting hosts file to stdout instead
  --hosts-file FILE          Target hosts file (default: /etc/hosts)
  --watch                    Keep running, updating on every container event
  -h, --help                 Show this help message

Container names are formatted as: container-name.DOMAIN

The managed entries are the ones between the '$MARKER_BEGIN' and
'$MARKER_END' markers, and every run rewrites all of them, so entries
for containers that are no longer running are removed.

--clean is accepted and ignored: it named the behaviour that is now the only one.
EOF
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --clean)
      # Retained as a no-op so that service files installed by earlier versions,
      # which always passed it, keep working
      shift
      ;;
    --domain)
      if [[ -z "${2-}" ]]; then
        echo "Error: --domain requires a value" >&2
        exit 1
      fi
      if [[ ! "$2" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
        echo "Error: Invalid --domain: $2" >&2
        exit 1
      fi
      DOMAIN="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --hosts-file)
      if [[ -z "${2-}" ]]; then
        echo "Error: --hosts-file requires a value" >&2
        exit 1
      fi
      HOSTS_FILE="$2"
      shift 2
      ;;
    --watch)
      WATCH=true
      shift
      ;;
    -h|--help)
      show_help
      exit
      ;;
    *)
      echo "Error: Unknown option $1" >&2
      exit 1
      ;;
  esac
done

require_docker() {
  if ! command -v docker > /dev/null 2>&1; then
    echo "Error: Docker command not found" >&2
    exit 1
  fi

  if ! docker info > /dev/null 2>&1; then
    echo "Error: Docker daemon is not running or not accessible" >&2
    exit 1
  fi
}

# Print the hostname label derived from container name $1, or nothing if the
# name has no valid label in it
to_hostname() {
  local name="$1"
  name="${name#/}"             # Remove leading slash
  name="${name//_/-}"          # Replace underscores with hyphens
  name="${name// /-}"          # Replace spaces with hyphens
  name="${name,,}"             # Convert to lowercase
  name="${name//[^a-z0-9-]/}"  # Keep only alphanumeric and hyphens

  if [[ "$name" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    echo "$name"
  fi
}

# Drop entries that repeat a hostname, since a hosts file only honours the
# first. The input must be sorted by hostname, so that repeats are adjacent.
drop_repeated_hostnames() {
  local ip hostname previous_hostname="" previous_ip=""

  while read -r ip hostname; do
    if [[ "$hostname" == "$previous_hostname" ]]; then
      echo "Warning: More than one container maps to '$hostname'; keeping $previous_ip and ignoring $ip" >&2
      continue
    fi
    previous_hostname=$hostname
    previous_ip=$ip
    echo "$ip $hostname"
  done
}

# Print "IP hostname" for every running container, sorted by hostname. A
# container that can't be mapped is reported and skipped rather than failing the
# run, so that one unusual container doesn't stop every other one from updating.
get_docker_entries() {
  local hostname ip name

  # `{{range}}` yields one address per network the container is attached to, in
  # sorted network order. Only the first is used: a hosts file maps a name to a
  # single address, and a container on two networks is normal, not an error.
  # `-r` keeps `xargs` from running `docker inspect` when nothing is up.
  docker ps -q \
    | xargs -r docker inspect --format "{{.Name}} {{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}" \
    | while read -r name ip _; do
        # Skip containers with no IP (e.g., host networking mode) or invalid IP
        if [[ -z "$ip" || "$ip" == "invalid" ]]; then
          continue
        fi
        hostname=$(to_hostname "$name")
        if [[ -z "$hostname" ]]; then
          echo "Warning: No valid hostname can be derived from container '$name'; skipping it" >&2
          continue
        fi
        echo "$ip ${hostname}.${DOMAIN}"
      done \
    | sort -k2 \
    | drop_repeated_hostnames
}

validate_hosts_file() {
  if [[ ! -f "$HOSTS_FILE" ]]; then
    echo "Error: Hosts file $HOSTS_FILE does not exist" >&2
    exit 1
  fi

  if [[ "$DRY_RUN" == false && ! -w "$HOSTS_FILE" ]]; then
    echo "Error: Cannot write to $HOSTS_FILE" >&2
    exit 1
  fi
}

# The contents of $HOSTS_FILE, and the bounds of the managed block within it
HOSTS_LINES=()
BLOCK_BEGIN_IDX=-1
BLOCK_END_IDX=-1

# Read $HOSTS_FILE into HOSTS_LINES and set BLOCK_BEGIN_IDX and BLOCK_END_IDX to
# the marker lines bounding the managed block. A file with no block gets an empty
# range at the end, which is where a new block belongs, so that the rest of the
# script needs no separate case for it; BLOCK_END_IDX > BLOCK_BEGIN_IDX is the
# test for whether the file already had one.
#
# Unbalanced or duplicated markers are an error: guessing at what they delimit
# risks deleting entries that this script doesn't manage.
read_hosts_file() {
  local line i
  HOSTS_LINES=()
  BLOCK_BEGIN_IDX=-1
  BLOCK_END_IDX=-1

  # The `[[ -n "$line" ]]` fallback keeps the last line of a file that doesn't
  # end in a newline, which `read` reports as a failure
  while IFS= read -r line || [[ -n "$line" ]]; do
    HOSTS_LINES+=("$line")
  done < "$HOSTS_FILE"

  for ((i = 0; i < ${#HOSTS_LINES[@]}; i++)); do
    case "${HOSTS_LINES[i]}" in
      "$MARKER_BEGIN")
        if (( BLOCK_BEGIN_IDX >= 0 )); then
          echo "Error: $HOSTS_FILE line $((i + 1)) is a second '$MARKER_BEGIN' marker; remove the duplicate block" >&2
          exit 1
        fi
        BLOCK_BEGIN_IDX=$i
        ;;
      "$MARKER_END")
        if (( BLOCK_BEGIN_IDX < 0 || BLOCK_END_IDX >= 0 )); then
          echo "Error: $HOSTS_FILE line $((i + 1)) is a '$MARKER_END' marker without a matching '$MARKER_BEGIN'; remove it" >&2
          exit 1
        fi
        BLOCK_END_IDX=$i
        ;;
    esac
  done

  if (( BLOCK_BEGIN_IDX >= 0 && BLOCK_END_IDX < 0 )); then
    echo "Error: $HOSTS_FILE line $((BLOCK_BEGIN_IDX + 1)) is a '$MARKER_BEGIN' marker without a matching '$MARKER_END'; add the closing marker or remove the block" >&2
    exit 1
  fi

  if (( BLOCK_BEGIN_IDX < 0 )); then
    BLOCK_BEGIN_IDX=${#HOSTS_LINES[@]}
    BLOCK_END_IDX=$((BLOCK_BEGIN_IDX - 1))
  fi
}

# Print $HOSTS_FILE with the managed block replaced by entry list $1
render_hosts_file() {
  local entries="$1" i

  for ((i = 0; i < BLOCK_BEGIN_IDX; i++)); do
    echo "${HOSTS_LINES[i]}"
  done

  echo "$MARKER_BEGIN"
  if [[ -n "$entries" ]]; then
    echo "$entries"
  fi
  echo "$MARKER_END"

  for ((i = BLOCK_END_IDX + 1; i < ${#HOSTS_LINES[@]}; i++)); do
    echo "${HOSTS_LINES[i]}"
  done
}

update() {
  local entries rendered

  entries=$(get_docker_entries)

  validate_hosts_file
  read_hosts_file

  if [[ -z "$entries" ]] && (( BLOCK_END_IDX < BLOCK_BEGIN_IDX )); then
    # There are no entries to write and no block to empty, so don't leave a bare
    # block behind in a file that never had one
    rendered=$(cat "$HOSTS_FILE")
  else
    rendered=$(render_hosts_file "$entries")
  fi

  if [[ "$DRY_RUN" == true ]]; then
    printf '%s\n' "$rendered"
    return
  fi

  # Say nothing and touch nothing when the file already reads the way it should,
  # so that a burst of container events doesn't rewrite it once per event
  if [[ "$rendered" == "$(cat "$HOSTS_FILE")" ]]; then
    return
  fi

  # Overwrite in place rather than renaming into place. A rename can't be caught
  # mid-write, but it swaps the file's inode, and /etc/hosts is often a symlink,
  # hard linked, or bind mounted into a container - all of which would go on
  # reading the inode this script had just replaced, and silently never update
  # again. Keeping the inode costs a brief window where the file is short.
  printf '%s\n' "$rendered" > "$HOSTS_FILE"
}

# Update once, then again after every container event, until `docker events`
# ends - which it does when the daemon goes away, leaving the service to be
# restarted against a daemon that has come back.
watch_docker_events() {
  update

  docker events --filter event=start --filter event=die --format "{{.Type}}" \
    | while read -r _; do
        # A failed update shouldn't end the watch. The subshell confines the
        # `exit` that an update raises on an unusable hosts file, so that a
        # hand-edit that breaks the markers can be fixed without a restart.
        (update) || echo "Warning: Update failed; retrying on the next container event" >&2
      done
}

# Linux only, on purpose: `xargs -r` and the systemd unit are GNU/systemd-isms,
# and container IPs generally aren't routable from a macOS host anyway
if [[ "$OSTYPE" != linux* ]]; then
  echo "Error: docker_etc_hosts supports Linux only, not $OSTYPE" >&2
  exit 1
fi

require_docker

if [[ "$WATCH" == true ]]; then
  watch_docker_events
else
  update
fi
