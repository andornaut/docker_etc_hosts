#!/bin/bash

# Usage: ./docker_etc_hosts [OPTIONS]

set -euo pipefail

# Exit on any command failure
trap 'echo "Error: Command failed on line $LINENO" >&2; exit 1' ERR

HOSTS_FILE="/etc/hosts"
DOMAIN="internal"
DRY_RUN=false
CLEAN=false
MARKER_BEGIN="# docker_etc_hosts BEGIN"
MARKER_END="# docker_etc_hosts END"

show_help() {
  cat << EOF
Update /etc/hosts with running Docker containers IPs and names

Usage: $0 [OPTIONS]

OPTIONS:
  --clean                    Replace all managed entries instead of updating in-place
  --domain DOMAIN            Domain for containers (default: internal)
  --dry-run                  Write to stdout instead of updating a hosts file
  --hosts-file FILE          Target hosts file (default: /etc/hosts)
  -h, --help                 Show this help message

Container names are formatted as: container-name.DOMAIN
EOF
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --clean)
      CLEAN=true
      shift
      ;;
    --domain)
      if [[ -z "${2-}" ]]; then
        echo "Error: --domain requires a value" >&2
        exit 1
      fi
      DOMAIN="$2"
      shift 2
      if [[ ! "$DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
        echo "Error: Invalid --domain: $DOMAIN" >&2
        exit 1
      fi
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --hosts-file)
      if [[ -z "${2-}" ]]; then
        echo "Error: --hosts-file requires a value" >&2
        exit 1
      fi
      HOSTS_FILE="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit
      ;;
    *)
      echo "Error: Unknown option $1" >&2
      exit 1
      ;;
  esac
done

to_hostname() {
  local name="$1"
  name="${name#/}"           # Remove leading slash
  name="${name//_/-}"        # Replace underscores with hyphens
  name="${name// /-}"        # Replace spaces with hyphens
  name="${name,,}"           # Convert to lowercase
  name="${name//[^a-z0-9-]/}"  # Keep only alphanumeric and hyphens

  if [[ "$name" =~ ^[a-z0-9](.*[a-z0-9])*$ ]]; then
    echo "$name"
  else
    echo
  fi
}

get_docker_entries() {
  # Check if Docker is available and running
  if ! command -v docker >/dev/null 2>&1; then
    echo "Error: Docker command not found" >&2
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker daemon is not running or not accessible" >&2
    exit 1
  fi

  local container_ids hostname ip name rest;
  container_ids=$(docker ps -q)

  # Perform this check manually instead of using the `-r` flag to `xargs`, b/c the latter isn't supported on macOS
  if [[ -z "$container_ids" ]]; then
    return
  fi

  echo "$container_ids" | xargs docker inspect --format "{{.Name}} {{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}" 2>/dev/null | while read -r name ip rest; do
    # Skip containers with no IP (e.g., host networking mode) or invalid IP
    if [[ -z "$ip" || "$ip" == "invalid" ]]; then
      continue
    fi
    if [[ -n "$rest" ]]; then
      echo "Error: Container $name has multiple IP addresses, which is not supported" >&2
      exit 1
    fi
    hostname=$(to_hostname "$name")
    if [[ -z "${hostname}" ]]; then
      echo "Error: The hostname derived from container '$name' is invalid: $hostname" >&2
      exit 1
    fi
    echo "$ip ${hostname}.${DOMAIN}"
  done | sort
}


validate_hosts_file() {
  if [[ ! -f "$HOSTS_FILE" ]]; then
    echo "Error: Hosts file $HOSTS_FILE does not exist" >&2
    exit 1
  fi

  if [[ ! -r "$HOSTS_FILE" ]]; then
    echo "Error: Cannot read $HOSTS_FILE" >&2
    exit 1
  fi

  if [[ "$DRY_RUN" == false && ! -w "$HOSTS_FILE" ]]; then
    echo "Error: Cannot write to $HOSTS_FILE" >&2
    exit 1
  fi
}

# The contents of $HOSTS_FILE, and the bounds of the managed block within it
HOSTS_LINES=()
BLOCK_BEGIN_IDX=-1
BLOCK_END_IDX=-1

# The entries to manage, keyed by hostname, and the order to write them in
declare -A ENTRY_IP=()
ENTRY_HOSTNAMES=()

# The fields of the line last passed to split_hosts_line: an IP, then hostnames
LINE_FIELDS=()

# Split a hosts file line into LINE_FIELDS. This assigns to a global rather than
# printing, because a command substitution forks a subshell and this runs for
# every line of the hosts file, on every container event.
split_hosts_line() {
  local line="${1%%#*}"
  # `read -ra` splits on whitespace without expanding globs
  read -ra LINE_FIELDS <<< "$line"
}

# Index the entry list $1 by hostname, dropping container names that collide
# once they've been normalized, since a hosts file can only honour the first
build_entry_index() {
  local entries="$1" hostname ip
  ENTRY_IP=()
  ENTRY_HOSTNAMES=()

  while IFS=' ' read -r ip hostname; do
    if [[ -z "$hostname" ]]; then
      continue
    fi
    if [[ -n "${ENTRY_IP[$hostname]+x}" ]]; then
      echo "Warning: More than one container maps to '$hostname'; keeping ${ENTRY_IP[$hostname]} and ignoring $ip" >&2
      continue
    fi
    ENTRY_IP[$hostname]=$ip
    ENTRY_HOSTNAMES+=("$hostname")
  done <<< "$entries"
}

# Read $HOSTS_FILE into HOSTS_LINES and locate the managed block. Unbalanced or
# duplicated markers are an error: guessing at what they delimit risks deleting
# entries that this script doesn't manage.
read_hosts_file() {
  local line i
  HOSTS_LINES=()
  BLOCK_BEGIN_IDX=-1
  BLOCK_END_IDX=-1

  # The `[[ -n "$line" ]]` fallback keeps the last line of a file that doesn't
  # end in a newline, which `read` reports as a failure
  while IFS= read -r line || [[ -n "$line" ]]; do
    HOSTS_LINES+=("$line")
  done < "$HOSTS_FILE"

  for ((i = 0; i < ${#HOSTS_LINES[@]}; i++)); do
    case "${HOSTS_LINES[i]}" in
      "$MARKER_BEGIN")
        if (( BLOCK_BEGIN_IDX >= 0 )); then
          echo "Error: $HOSTS_FILE line $((i + 1)) is a second '$MARKER_BEGIN' marker; remove the duplicate block" >&2
          exit 1
        fi
        BLOCK_BEGIN_IDX=$i
        ;;
      "$MARKER_END")
        if (( BLOCK_BEGIN_IDX < 0 || BLOCK_END_IDX >= 0 )); then
          echo "Error: $HOSTS_FILE line $((i + 1)) is a '$MARKER_END' marker without a matching '$MARKER_BEGIN'; remove it" >&2
          exit 1
        fi
        BLOCK_END_IDX=$i
        ;;
    esac
  done

  if (( BLOCK_BEGIN_IDX >= 0 && BLOCK_END_IDX < 0 )); then
    echo "Error: $HOSTS_FILE line $((BLOCK_BEGIN_IDX + 1)) is a '$MARKER_BEGIN' marker without a matching '$MARKER_END'; add the closing marker or remove the block" >&2
    exit 1
  fi
}

# Warn about entries that precede the managed block and map one of its
# hostnames, eg. those written by versions of this script that predate the
# markers. The first match in a hosts file wins, so they mask the managed entry.
warn_shadowed_entries() {
  local hostname i j last

  # Lines after the block can't shadow it. Without a block, one is appended to
  # the end of the file, so every existing line precedes it.
  last=$BLOCK_BEGIN_IDX
  if (( last < 0 )); then
    last=${#HOSTS_LINES[@]}
  fi

  for ((i = 0; i < last; i++)); do
    split_hosts_line "${HOSTS_LINES[i]}"
    for ((j = 1; j < ${#LINE_FIELDS[@]}; j++)); do
      # Hostname lookups ignore case, so a match here has to as well
      hostname=${LINE_FIELDS[j],,}
      if [[ -n "${ENTRY_IP[$hostname]+x}" ]]; then
        echo "Warning: $HOSTS_FILE line $((i + 1)) maps '${LINE_FIELDS[j]}' ahead of the managed block and will take precedence over it; remove that line" >&2
      fi
    done
  done
}

# Print the managed block. Unless --clean was given, the existing block's lines
# are updated in-place and the ones that don't match an entry are preserved.
render_block() {
  local -A written=()
  local hostname i line

  echo "$MARKER_BEGIN"

  if [[ "$CLEAN" == false ]] && (( BLOCK_BEGIN_IDX >= 0 )); then
    for ((i = BLOCK_BEGIN_IDX + 1; i < BLOCK_END_IDX; i++)); do
      line="${HOSTS_LINES[i]}"
      split_hosts_line "$line"
      hostname=""
      if (( ${#LINE_FIELDS[@]} > 1 )); then
        hostname=${LINE_FIELDS[1],,}
      fi
      if [[ -z "$hostname" || -z "${ENTRY_IP[$hostname]+x}" ]]; then
        # Preserve existing lines in the block that don't match a new entry
        echo "$line"
      elif [[ -z "${written[$hostname]+x}" ]]; then
        echo "${ENTRY_IP[$hostname]} $hostname"
        written[$hostname]=1
      fi
    done
  fi

  # Append the entries that didn't update an existing line
  for ((i = 0; i < ${#ENTRY_HOSTNAMES[@]}; i++)); do
    hostname=${ENTRY_HOSTNAMES[i]}
    if [[ -z "${written[$hostname]+x}" ]]; then
      echo "${ENTRY_IP[$hostname]} $hostname"
      written[$hostname]=1
    fi
  done

  echo "$MARKER_END"
}

# Rewrite $HOSTS_FILE with the managed block set to the indexed entries
write_hosts_file() {
  local i link_count temp_file

  # Write beside the target so that the rename below is atomic, which keeps the
  # file resolvable at every instant and leaves no torn writes behind
  temp_file=$(mktemp "$(dirname "$HOSTS_FILE")/.$(basename "$HOSTS_FILE").XXXXXX" 2>/dev/null) \
    || temp_file=$(mktemp)
  # shellcheck disable=SC2064  # $temp_file is expanded now, on purpose
  trap "rm -f -- '$temp_file'" EXIT
  # Copy first so the rewrite inherits the original's ownership and permissions,
  # plus its extended attributes and security context where cp supports them
  cp --preserve=all "$HOSTS_FILE" "$temp_file" 2>/dev/null \
    || cp -p "$HOSTS_FILE" "$temp_file"

  {
    if (( BLOCK_BEGIN_IDX < 0 )); then
      for ((i = 0; i < ${#HOSTS_LINES[@]}; i++)); do
        echo "${HOSTS_LINES[i]}"
      done
      render_block
    else
      for ((i = 0; i < BLOCK_BEGIN_IDX; i++)); do
        echo "${HOSTS_LINES[i]}"
      done
      render_block
      for ((i = BLOCK_END_IDX + 1; i < ${#HOSTS_LINES[@]}; i++)); do
        echo "${HOSTS_LINES[i]}"
      done
    fi
  } > "$temp_file"

  link_count=$(stat -c %h "$HOSTS_FILE" 2>/dev/null || stat -f %l "$HOSTS_FILE" 2>/dev/null || echo 1)

  # A rename would replace a symlink rather than what it points at, leave any
  # hard links to the file behind on the old inode, and can't replace a bind
  # mount at all - all three are plausible for /etc/hosts - so fall back to
  # overwriting in place whenever the target isn't a standalone plain file
  if [[ -L "$HOSTS_FILE" ]] || (( link_count > 1 )) \
    || ! mv -f "$temp_file" "$HOSTS_FILE" 2>/dev/null; then
    cat "$temp_file" > "$HOSTS_FILE"
    rm -f -- "$temp_file"
  fi
  trap - EXIT
}

entries=$(get_docker_entries)

if [[ -z "$entries" ]]; then
  echo "Warning: No running Docker containers found with applicable network configurations" >&2
  # Without --clean there is nothing to write, but --clean still has stale
  # entries to remove even when no containers are running
  if [[ "$CLEAN" == false ]]; then
    exit
  fi
fi

build_entry_index "$entries"

# Inspect the hosts file even for --dry-run, so that a preview reports the same
# marker errors and shadowed entries that a real run would. A preview of a file
# that doesn't exist yet is still worth printing, though.
if [[ "$DRY_RUN" == false || -e "$HOSTS_FILE" ]]; then
  validate_hosts_file
  read_hosts_file
  warn_shadowed_entries
fi

if [[ "$DRY_RUN" == true ]]; then
  if (( ${#ENTRY_HOSTNAMES[@]} == 0 )); then
    echo "Would remove all entries between '$MARKER_BEGIN' and '$MARKER_END' from $HOSTS_FILE"
  else
    for ((i = 0; i < ${#ENTRY_HOSTNAMES[@]}; i++)); do
      echo "${ENTRY_IP[${ENTRY_HOSTNAMES[i]}]} ${ENTRY_HOSTNAMES[i]}"
    done
  fi
  exit
fi

write_hosts_file
