#!/bin/bash

# Usage: ./test_docker_etc_hosts
#
# Runs docker_etc_hosts against synthetic hosts files, with a stubbed `docker`
# on the PATH, and asserts on the result.

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SCRIPT="$SCRIPT_DIR/docker_etc_hosts"
MARKER_BEGIN="# docker_etc_hosts BEGIN"
MARKER_END="# docker_etc_hosts END"

WORK=$(mktemp -d)
trap 'rm -rf -- "$WORK"' EXIT

# Stub `docker` with one that reports the containers listed in $CONTAINERS_FILE,
# one "id name ip..." per line
mkdir -p "$WORK/bin"
cat > "$WORK/bin/docker" << 'EOF'
#!/bin/bash
case "$1" in
  info) ;;
  ps) cut -d' ' -f1 < "$CONTAINERS_FILE" ;;
  events)
    # Record the arguments so the test can assert on the filters
    echo "$*" > "$EVENTS_ARGS_FILE"
    # Swap in a different set of containers before emitting anything, so that a
    # test can tell the per-event updates apart from the one at startup
    if [[ -s "$EVENTS_CONTAINERS_FILE" ]]; then
      cat "$EVENTS_CONTAINERS_FILE" > "$CONTAINERS_FILE"
    fi
    # Give a test a chance to interfere once the startup update is done
    if [[ -x "$EVENTS_HOOK" ]]; then
      "$EVENTS_HOOK"
    fi
    # Replay the scripted event stream and exit, ending the caller's read loop
    cat "$EVENTS_FILE"
    ;;
  inspect)
    # Skip past `inspect --format <format>` to the container ids
    shift 3
    for wanted in "$@"; do
      while read -r id name ips; do
        if [[ "$id" == "$wanted" ]]; then
          # Container names are `/`-prefixed, as `{{.Name}}` reports them, and
          # `{{range}}` emits one trailing-spaced address per network
          echo "/$name $ips "
        fi
      done < "$CONTAINERS_FILE"
    done
    ;;
esac
EOF
chmod +x "$WORK/bin/docker"
export PATH="$WORK/bin:$PATH"
export CONTAINERS_FILE="$WORK/containers"
export EVENTS_FILE="$WORK/events"
export EVENTS_ARGS_FILE="$WORK/events-args"
export EVENTS_CONTAINERS_FILE="$WORK/events-containers"
export EVENTS_HOOK="$WORK/events-hook"
: > "$EVENTS_FILE"
: > "$EVENTS_CONTAINERS_FILE"

HOSTS_FILE="$WORK/hosts"
passed=0
failed=0

# Declare the running containers, as "id name ip [ip...]" arguments
containers() {
  printf '%s\n' "$@" > "$CONTAINERS_FILE"
}

# Declare the containers that `docker events` swaps in before emitting events
containers_after_watch_starts() {
  printf '%s\n' "$@" > "$EVENTS_CONTAINERS_FILE"
}

# Run shell command $1 once the watch's startup update is done, and before the
# first event reaches it
hook_after_watch_starts() {
  printf '#!/bin/bash\n%s\n' "$1" > "$EVENTS_HOOK"
  chmod +x "$EVENTS_HOOK"
}

# Write $1 to the hosts file under test
hosts() {
  printf '%s' "$1" > "$HOSTS_FILE"
}

# Run the script under test, capturing stderr in $WORK/err
run() {
  "$SCRIPT" --hosts-file "$HOSTS_FILE" "$@" 2> "$WORK/err"
}

check() {
  local name="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    echo "PASS: $name"
    passed=$((passed + 1))
    return
  fi
  echo "FAIL: $name"
  echo "--- expected ---"
  printf '%s\n' "$expected"
  echo "--- actual ---"
  printf '%s\n' "$actual"
  echo "--------------"
  failed=$((failed + 1))
}

check_hosts_file() {
  check "$1" "$2" "$(cat "$HOSTS_FILE")"
}

check_stderr_matches() {
  local name="$1" pattern="$2"
  if grep -q -- "$pattern" "$WORK/err"; then
    check "$name" "" ""
  else
    check "$name" "stderr matching: $pattern" "$(cat "$WORK/err")"
  fi
}

echo "== A hosts file that doesn't end in a newline keeps its last line =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
8.8.8.8 dns.example"
run
check_hosts_file "the unterminated line survives" "127.0.0.1 localhost
8.8.8.8 dns.example
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END"

echo "== Content outside the block is preserved =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
$MARKER_BEGIN
10.9.9.9 web.internal web
$MARKER_END
192.168.1.5 important.corp
"
run
check_hosts_file "only the block is rewritten" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END
192.168.1.5 important.corp"

echo "== Repeated runs converge =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
"
run
run
run
check_hosts_file "the file stops changing" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END"

echo "== Every run drops containers that are no longer running =="
containers "abc web 10.0.0.1" "def db 10.0.0.2"
hosts "127.0.0.1 localhost
"
run
check_hosts_file "both containers are listed, sorted by hostname" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.2 db.internal
10.0.0.1 web.internal
$MARKER_END"
containers "abc web 10.0.0.1"
run
check_hosts_file "the stopped container is removed" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END"

echo "== --clean is still accepted, and changes nothing =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
"
run --clean
check "the exit status is 0" "0" "$?"
check_hosts_file "the result matches a plain run" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END"

echo "== With no running containers, the block is emptied =="
containers ""
hosts "127.0.0.1 localhost
$MARKER_BEGIN
10.9.9.9 web.internal
$MARKER_END
"
run
check_hosts_file "the stale entry is removed" "127.0.0.1 localhost
$MARKER_BEGIN
$MARKER_END"

echo "== A file with no block and nothing to add is left alone =="
containers ""
hosts "127.0.0.1 localhost
"
run
check_hosts_file "no empty block is added" "127.0.0.1 localhost"
check "the preview agrees" "127.0.0.1 localhost" "$(run --dry-run)"

echo "== Unbalanced markers are refused rather than guessed at =="
containers "abc web 10.0.0.1"
for broken in \
  "$MARKER_END" \
  "$MARKER_BEGIN" \
  "$MARKER_BEGIN
$MARKER_END
$MARKER_BEGIN
$MARKER_END"; do
  hosts "127.0.0.1 localhost
$broken
10.9.9.9 web.internal
192.168.1.5 important.corp
"
  before=$(cat "$HOSTS_FILE")
  run
  check "the exit status is 1" "1" "$?"
  check_hosts_file "no entries are lost" "$before"
  check_stderr_matches "the offending line is named" "^Error: .* line [0-9]"
done

echo "== One unmappable container doesn't stop the others =="
containers "abc web 10.0.0.1 172.20.0.5" "def --- 10.0.0.2" "ghi db 10.0.0.3"
hosts ""
run
check "the exit status is 0" "0" "$?"
check_hosts_file "the mappable containers are written" "$MARKER_BEGIN
10.0.0.3 db.internal
10.0.0.1 web.internal
$MARKER_END"
check_stderr_matches "the unnameable container is reported" \
  "No valid hostname can be derived from container '/---'"

echo "== A container with no address is skipped quietly =="
containers "abc hostmode" "def db 10.0.0.3"
hosts ""
run
check_hosts_file "only the addressable container is written" "$MARKER_BEGIN
10.0.0.3 db.internal
$MARKER_END"
check "nothing is reported" "" "$(cat "$WORK/err")"

echo "== A container on several networks uses its first address =="
containers "abc web 172.20.0.5 10.0.0.1"
hosts ""
run
check_hosts_file "the first address wins" "$MARKER_BEGIN
172.20.0.5 web.internal
$MARKER_END"

echo "== Containers that normalize to one hostname yield one entry =="
containers "abc my_app 10.0.0.1" "def my-app 10.0.0.2"
hosts ""
run
check_hosts_file "the repeated entry is dropped, not duplicated" "$MARKER_BEGIN
10.0.0.1 my-app.internal
$MARKER_END"
check_stderr_matches "the collision is reported" "More than one container maps to 'my-app.internal'"

echo "== --dry-run prints the file it would write, and writes nothing =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
"
check "the resulting file is printed" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END" "$("$SCRIPT" --hosts-file "$HOSTS_FILE" --dry-run 2> /dev/null)"
check_hosts_file "the file is untouched" "127.0.0.1 localhost"

hosts "$MARKER_END
127.0.0.1 localhost
"
before=$(cat "$HOSTS_FILE")
run --dry-run
check "unbalanced markers fail the preview too" "1" "$?"
check_hosts_file "the file is untouched" "$before"
check_stderr_matches "the offending line is named" "^Error: .* line 1"

echo "== An update that would change nothing doesn't touch the file =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
"
run
mtime_before=$(stat -c %Y "$HOSTS_FILE")
inode_before=$(stat -c %i "$HOSTS_FILE")
touch -d '@0' "$HOSTS_FILE" 2> /dev/null || touch -t 197001010000 "$HOSTS_FILE"
run
check "the file is left untouched" "0" "$(stat -c %Y "$HOSTS_FILE")"
touch -d "@$mtime_before" "$HOSTS_FILE" 2> /dev/null || true

echo "== The file keeps its inode, so links and bind mounts follow it =="
containers "abc web 10.0.0.2"
run
check "the inode is unchanged" "$inode_before" "$(stat -c %i "$HOSTS_FILE")"
ln -f "$HOSTS_FILE" "$WORK/hosts-link"
containers "abc web 10.0.0.3"
run
check "a hard link sees the update" "$(cat "$HOSTS_FILE")" "$(cat "$WORK/hosts-link")"
rm -f "$WORK/hosts-link"

echo "== A large hosts file is rewritten without forking per line =="
containers "abc web 10.0.0.1"
awk 'BEGIN { for (i = 0; i < 20000; i++) print "10.1." int(i / 256) "." (i % 256) " host" i ".example" }' > "$HOSTS_FILE"
started=$SECONDS
run
check "20k lines finish in a few seconds" "under 10s" \
  "$(if (( SECONDS - started < 10 )); then echo "under 10s"; else echo "$((SECONDS - started))s"; fi)"
check "the block is appended once" "1" "$(grep -c -- "^$MARKER_BEGIN$" "$HOSTS_FILE")"

echo "== Ownership and permissions survive a rewrite =="
containers "abc web 10.0.0.1"
hosts "127.0.0.1 localhost
"
chmod 640 "$HOSTS_FILE"
run
check "the mode is preserved" "640" "$(stat -c %a "$HOSTS_FILE" 2> /dev/null || stat -f %Lp "$HOSTS_FILE")"

echo "== A symlinked hosts file is followed, not replaced =="
containers "abc web 10.0.0.1"
printf '127.0.0.1 localhost\n' > "$WORK/real-hosts"
rm -f "$HOSTS_FILE"
ln -s "$WORK/real-hosts" "$HOSTS_FILE"
run
check "the symlink survives" "$WORK/real-hosts" "$(readlink "$HOSTS_FILE")"
check "the target is updated" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END" "$(cat "$WORK/real-hosts")"
rm -f "$HOSTS_FILE"

echo "== --watch updates before waiting for any event =="
containers "abc web 10.0.0.1"
containers_after_watch_starts
hosts "127.0.0.1 localhost
"
: > "$EVENTS_FILE"
run --watch
check_hosts_file "the update happens at startup" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.1 web.internal
$MARKER_END"
for event in start die; do
  if grep -q -- "--filter event=$event" "$EVENTS_ARGS_FILE"; then
    check "$event events are watched" "" ""
  else
    check "$event events are watched" "--filter event=$event" "$(cat "$EVENTS_ARGS_FILE")"
  fi
done

echo "== --watch updates again on every event =="
containers "abc web 10.0.0.1"
containers_after_watch_starts "abc web 10.0.0.9" "def db 10.0.0.2"
hosts "127.0.0.1 localhost
"
printf 'container\ncontainer\n' > "$EVENTS_FILE"
run --watch
check_hosts_file "the post-event state is applied" "127.0.0.1 localhost
$MARKER_BEGIN
10.0.0.2 db.internal
10.0.0.9 web.internal
$MARKER_END"

echo "== A hosts file broken mid-watch is reported, and doesn't end the watch =="
containers "abc web 10.0.0.1"
containers_after_watch_starts "abc web 10.0.0.1"
# Add a stray marker once the startup update has succeeded, so that the update
# the event triggers is the one that fails
hook_after_watch_starts "printf '%s\\n' '$MARKER_END' >> '$HOSTS_FILE'"
hosts "127.0.0.1 localhost
"
printf 'container\ncontainer\n' > "$EVENTS_FILE"
run --watch
check "the watch still exits cleanly" "0" "$?"
check_stderr_matches "each failure is reported" "retrying on the next container event"
check_stderr_matches "the offending line is named" "^Error: .* line [0-9]"
check "the watch survived to see both events" "2" \
  "$(grep -c -- "retrying on the next container event" "$WORK/err")"
rm -f "$EVENTS_HOOK"

echo "== The systemd unit runs the script in watch mode =="
exec_start=$(grep '^ExecStart=' "$SCRIPT_DIR/docker-etc-hosts.service")
check "ExecStart just runs the installed script" \
  "ExecStart=/usr/local/bin/docker_etc_hosts --watch" "$exec_start"

echo
echo "passed: $passed, failed: $failed"
[[ "$failed" -eq 0 ]]
